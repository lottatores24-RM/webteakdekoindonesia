# Public site URL (used for canonical URLs, sitemap, hreflang, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.teakdekoindonesia.com

# Inquiry form email delivery (https://resend.com)
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Teak & Deko Website <website@teakdekoindonesia.com>"
INQUIRY_FROM_EMAIL=Teak & Deko Website <onboarding@resend.dev>
# Where inquiries are delivered (comma separated for several)
INQUIRY_TO_EMAIL=teakdekoindo@gmail.com

# Analytics — leave empty to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
